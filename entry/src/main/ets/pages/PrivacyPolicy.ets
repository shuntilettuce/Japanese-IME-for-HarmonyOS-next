import { LegalDocView } from '../components/LegalDocView';

@Entry
@Component
struct PrivacyPolicy {
  private readonly bodyText: string =
    '■ はじめに\n' +
    'shunti Japanese IME（以下「本アプリ」）は、開発者 shuntilettuce が提供する HarmonyOS NEXT 向けの日本語入力メソッド（IME）です。\n\n' +
    'アプリ名：shunti Japanese IME\n' +
    '開発者名：shuntilettuce\n\n' +
    '本アプリをご利用いただく前に、このプライバシーポリシーをよくお読みください。\n\n' +
    '■ 収集する情報\n' +
    '本アプリは、以下の情報をお客様のデバイス上でのみ処理します。\n\n' +
    '・入力テキスト（変換・候補表示のためにデバイス内でのみ処理）\n' +
    '・変換履歴（変換精度向上のためにデバイス内のみに保存）\n' +
    '・ユーザー登録単語（任意で登録した読み・単語のペア）\n' +
    '・クリップボードの内容（コピーしたテキストや画像を変換候補バーと履歴に表示し、タップで貼り付けるために使用。履歴は端末内のアプリ専用領域にだけ保存し（最大50件・30日。画像は縮小した見本のみ）、外部送信は行いません。履歴はクリップボードの画面の「削除」で消せます）\n\n' +
    '上記の情報は外部サーバーへ送信・アップロードされることはありません。\n\n' +
    '■ 情報の利用目的\n' +
    '収集した情報は以下の目的にのみ使用します。\n\n' +
    '・かな漢字変換候補の生成\n' +
    '・変換精度向上のための学習（デバイス内のみ）\n' +
    '・ユーザー辞書機能の提供\n\n' +
    '■ 情報の保存\n' +
    '変換履歴およびユーザー登録単語は、HarmonyOS の Preferences API を使用してお客様のデバイス内にのみ保存されます。外部サービスやクラウドへの保存は一切行いません。\n\n' +
    '保存データはアプリのアンインストールにより削除されます。\n\n' +
    '■ 第三者への提供\n' +
    '本アプリは、お客様の入力データ・変換履歴・ユーザー辞書を第三者に提供・販売・共有することはありません。\n\n' +
    '■ バンドルデータについて\n' +
    '本アプリには変換辞書データ（dict.json, global_dict.json）が含まれています。これらは読み取り専用のデータファイルであり、お客様の入力内容とは独立しています。文節分割は外部データファイルに依存せず、文法ルールをアプリ内に実装した独自のアルゴリズムで行っています。\n\n' +
    '辞書データの出典：常用漢字（パブリックドメイン）、Unicode Unihan（パブリックドメイン）、Wikipedia日本語版（CC BY-SA 4.0）、Wiktionary日本語版（CC BY-SA 4.0 / GFDL）、JMdict/EDICT（CC BY-SA 4.0、https://www.edrdg.org/wiki/index.php/JMdict-EDICT_Dictionary_Project）、日本郵便 郵便番号データ、独自収集データ。詳細はリポジトリ内 DATA_SOURCES.md を参照。\n\n' +
    '■ クラッシュレポート・分析\n' +
    '本アプリは分析ツールやクラッシュレポートサービスを使用していません。\n\n' +
    '■ お子様のプライバシー\n' +
    '本アプリは13歳未満のお子様からの個人情報を意図的に収集しません。\n\n' +
    '■ ポリシーの変更\n' +
    '本プライバシーポリシーは予告なく変更される場合があります。変更後も本アプリをご利用いただいた場合、変更後のポリシーに同意されたものとみなします。\n\n' +
    '■ お問い合わせ\n' +
    'プライバシーに関するご質問は、AppGallery の開発者情報に記載のメールアドレスまでお問い合わせください。\n\n' +
    '最終更新: 2026年6月';

  build() {
    Column() {
      LegalDocView({
        pageTitle: 'プライバシーポリシー',
        bodyText: this.bodyText
      })
    }
    .width('100%')
    .height('100%')
  }
}
